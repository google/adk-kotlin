<!-- Makes the test APK its own AppFunctions provider, which is what lets the toolset discover
these functions without any permission. It is merged into the device-test APK as the
androidDeviceTest source set's manifest, so `connectedAndroidTest` finds the service registered.
This is the single declaration of it, so an edit here reaches every build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The compiler generates TestAppFunctionService from BaseTestAppFunctionService, along
        with the XML naming its functions. -->
        <service
            android:name="com.google.adk.kt.tools.appfunctions.TestAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
            <property
                android:name="android.app.appfunctions.v2"
                android:value="adk_test_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
